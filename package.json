{
  "name": "safety-histogram",
  "description": "Histogram showing distribution of lab measures, vital signs and other related measures in clinical trials.",
  "version": "3.0.0-alpha.0",
  "author": "Rho, Inc.",
  "license": "MIT",
  "homepage": "https://github.com/obot-claw/safety-histogram#readme",
  "module": "./src/index.js",
  "main": "./safetyHistogram.js",
  "keywords": [
    "labs",
    "vitals",
    "ecg",
    "bds",
    "histogram",
    "data",
    "visualization",
    "safety",
    "explorer"
  ],
  "dependencies": {
    "chart.js": "^4.4.9"
  },
  "scripts": {
    "build": "npm run bundle",
    "bundle": "rollup -c",
    "format": "npm run format-src && npm run format-bundle",
    "format-src": "prettier --print-width=100 --tab-width=4 --single-quote --write \"./src/**/!(*styles).js\"",
    "format-bundle": "prettier --print-width=100 --tab-width=4 --single-quote --write ./safetyHistogram.js",
    "test": "npm run build",
    "watch": "rollup -c -w",
    "demo": "python3 -m http.server 8098",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@babel/core": "^7.4.5",
    "@babel/preset-env": "^7.4.5",
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0",
    "prettier": "^1.19.1",
    "rollup": "^1.27.1",
    "rollup-plugin-babel": "^4.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/obot-claw/safety-histogram.git"
  },
  "bugs": {
    "url": "https://github.com/obot-claw/safety-histogram/issues"
  }
}
